{
  "name": "farabitech",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=@farabitech/admin",
    "dev:profile": "npm run dev --workspace=@farabitech/profile",
    "build:admin": "npm run build --workspace=@farabitech/admin",
    "lint": "eslint .",
    "typecheck": "tsc -b apps/admin apps/profile",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "msw": {
    "workerDirectory": [
      "apps\\admin\\public",
      "apps\\profile\\public"
    ]
  }
}